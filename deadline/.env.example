# Скопируйте в .env и подставьте свои значения. Этот файл можно коммитить.

PORT=3001
NODE_ENV=development

# Локальный PostgreSQL. В docker-compose хост называется db.
DATABASE_URL=postgresql://deadline:deadline@127.0.0.1:5432/deadline

# Не короче 16 символов. Не используйте пример ниже в опубликованном сервисе.
JWT_SECRET=replace-with-a-long-random-string

# Origin, который браузер считает сайтом. Локально это Vite.
FRONTEND_ORIGIN=http://localhost:5173

# Origin, который указан в кабинете OAuth как база redirect URI.
# Локально совпадает с Vite: колбэк идёт через прокси /api.
PUBLIC_API_ORIGIN=http://localhost:5173

# true только за HTTPS.
COOKIE_SECURE=false

# Оставьте пустым, если провайдер не подключён. Кнопки покажут понятную ошибку.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Номер счётчика Яндекс Метрики. Пусто — скрипт не вставляется.
# На Vercel задайте его до сборки: Vite вшивает значение в статику.
VITE_METRIKA_ID=

# Секрет ежедневной проверки Vercel Cron. Не короче 16 символов.
# Vercel сам шлёт его как Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
